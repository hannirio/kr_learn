  "grammar": [
    {
      "id": "b2_g1_1",
      "pattern": "V/A-기 때문에, N이기 때문에",
      "meaning": "因为……，由于……（表示原因、理由）",
      "usage": "惯用型，接在谓词词干后表示原因、理由，主要用于书面语。后句（终结谓语）不能使用命令式和共动式。也可接在“名词+이다”之后，构成“N이기 때문에”。 也可直接用在名词后，构成“N 때문에”。",
      "examples": [
        {
          "kr": "다른 사람들과 같이 일하기 때문에 힘들지 않습니다.",
          "cn": "因为是和别人一起工作，所以不辛苦。"
        },
        {
          "kr": "큰 수술을 했기 때문에 움직일 수 없어요.",
          "cn": "因为做了大手术，所以不能动。"
        },
        {
          "kr": "저는 외국인이기 때문에 한국말을 잘 못합니다.",
          "cn": "因为我是外国人，所以韩语说得不太好。"
        },
        {
          "kr": "방학이기 때문에 한가합니다.",
          "cn": "因为放假了，所以很清闲。"
        },
        {
          "kr": "모두 친절한 분들이기 때문에 잘 가르쳐 주실 거예요.",
          "cn": "大家都很亲切，所以会好好教你的。"
        },
        {
          "kr": "지금은 수업 시간이기 때문에 전화를 받을 수 없습니다.",
          "cn": "因为现在是上课时间，所以不能接听电话。"
        },
        {
          "kr": "아이들 때문에 행복합니다.",
          "cn": "因为孩子们而幸福。（N 때문에：直接用在名词后）"
        },
        {
          "kr": "날씨 때문에 기분이 안 좋아요.",
          "cn": "因为天气心情不好。"
        }
      ]
    },
    {
      "id": "b2_g1_2",
      "pattern": "N이든지/든지",
      "meaning": "无论……都（表示无条件包括）",
      "usage": "补助词，用于体词后，表示无条件包括，前面通常有“언제、어디、누구、무엇(뭐)、얼마”等疑问词。末音节有收音的体词后用“이든지”，无收音的体词后用“든지”。",
      "examples": [
        {
          "kr": "아침은 언제든지 7시에 먹어요.",
          "cn": "早饭总是7点吃。"
        },
        {
          "kr": "필요하면 얼마든지 가져 가세요.",
          "cn": "如果您需要，请尽管拿走。"
        },
        {
          "kr": "돼지고기만 아니면 뭐든지 잘 먹어요.",
          "cn": "除了猪肉，我什么都喜欢吃。"
        },
        {
          "kr": "우리 학교 학생이면 누구든지 출입할 수 있습니다.",
          "cn": "只要是我们学校的学生，谁都可以进去。"
        },
        {
          "kr": "도움이 필요하면 언제든지 말씀하세요.",
          "cn": "如果需要帮助，请随时跟我说。"
        }
      ]
    },
    {
      "id": "b2_g1_3",
      "pattern": "-어지다/아지다/여지다",
      "meaning": "变得……（表示某种状态逐渐形成）",
      "usage": "惯用型。用于形容词词干后，表示某种状态逐渐形成。相当于汉语的“变得……”。",
      "examples": [
        {
          "kr": "열심히 연습해서 발음이 좋아졌어요.",

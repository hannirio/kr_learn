  "grammar": [
    {
      "id": "g6_1",
      "pattern": "V-으러/러 가다(오다)",
      "meaning": "去（来）做……（表示移动的目的或意图）",
      "usage": "接在动词词干后面的连接词尾，通常与移动性动词（“가다”、“오다”、“다니다”等）连用，表示移动的目的或意图。如果动词词干以元音或收音“ㄹ”结尾用“-러”，以除“ㄹ”以外的辅音（有收音）结尾用“-으러”。",
      "examples": [
        { "kr": "영화를 보러 갈까요?", "cn": "我们去看电影怎么样？" },
        { "kr": "한잔 하러 갑시다.", "cn": "我们去喝酒吧。" },
        { "kr": "밥 먹으러 식당에 갔다 왔어요.", "cn": "我去餐厅吃饭了。" },
        { "kr": "구경하러 온 사람이 많습니다.", "cn": "来看的人很多。" },
        { "kr": "돈을 찾으러 은행에 갔습니다.", "cn": "我去银行取钱了。" }
      ]
    },
    {
      "id": "g6_2",
      "pattern": "N과/와",
      "meaning": "……和……，与……（连接助词，表示并列关系）",
      "usage": "连接助词，用于体词和体词的连接，表示并列关系或共同动作的对象。如果前面的体词以辅音（有收音）结尾用“과”，以元音（无收音）结尾用“와”。在口语中常用“하고”代替。",
      "examples": [
        { "kr": "나는 봄과 가을을 좋아합니다.", "cn": "我喜欢春天和秋天。" },
        { "kr": "동생과 누나가 집에서 기다립니다.", "cn": "弟弟和姐姐都在家等着呢。" },
        { "kr": "책상 위에 시계와 책이 있습니다.", "cn": "桌子上有钟表和书。" }
      ]
    },
    {
      "id": "g6_3",
      "pattern": "V/A-지만",
      "meaning": "虽然……但是……（表示转折关系的连接词尾）",
      "usage": "用于谓词（动词、形容词）词干、体词谓词形“N(이)다”或过去时制词尾“-었/았/였-”后面的连接词尾，表示转折关系，承认前一事实的同时提出与之相反或相对的后一事实。",
      "examples": [
        { "kr": "값은 비싸지만 물건이 좋아요.", "cn": "价钱虽然贵了些，但是东西质量很好。" },
        { "kr": "바람은 불지만 비는 안 와요.", "cn": "虽然刮风，但是没有下雨。" },
        { "kr": "그 사람은 부자지만 돈을 안 써요.", "cn": "他虽然很富有，但是不花钱。" },
        { "kr": "약을 먹었지만 낫지 않아요.", "cn": "虽然吃了药，但病还是不见好。" }
      ]
    },
    {
      "id": "g6_4",
      "pattern": "A-은/ㄴ (관형사형 어미¹)",
      "meaning": "……的（形容词定语词尾，表示事物现在的性质或状态）",
      "usage": "用于形容词词干和体词谓词形后面，修饰后面的体词充当定语成分，表示事物现在的性质、状态。如果前面词干以辅音（有收音）结尾用“-은”（如：좋다 → 좋은 집）；以元音（无收音）结尾用“-ㄴ”（如：예쁘다 → 예쁜 꽃；以收音“ㄹ”结尾时“ㄹ”脱落加“-ㄴ”，如：멀다 → 먼 고향、길다 → 긴 연필）。注意以“있/없-”结尾的形容词（如 재미있다、맛있다）作定语时接“-는”。",
      "examples": [
        { "kr": "키가 큰 사람이 동생입니다.", "cn": "个子高的是弟弟。" },
        { "kr": "오늘은 바쁜 날입니다.", "cn": "今天是繁忙的一天。" },
        { "kr": "돈이 많은 사람이 한턱 내십시오.", "cn": "让有钱人请客吧。" },
        { "kr": "꽃이 예쁩니다. → 예쁜 꽃", "cn": "花很漂亮。→ 漂亮的花" },
        { "kr": "집이 좋습니다. → 좋은 집", "cn": "房子很好。→ 好房子" }
      ]
    },
    {
      "id": "g6_5",
      "pattern": "‘ㅎ’ 불규칙 용언",
      "meaning": "“ㅎ”不规则谓词（“ㅎ”特殊音变）",
      "usage": "以收音“ㅎ”结尾的部分形容词词干（如 빨갛다、파랗다、노랗다、하얗다、까맣다、어떻다、이렇다、저렇다、그렇다）和以“ㄴ、ㄹ、ㅁ、ㅂ”或元音开头的词尾连接时，“ㅎ”脱落。若后面接以“-으-”开头的词尾，“ㅎ”和词尾的“으”都脱落（如：빨갛다 + -은 → 빨간，어떻다 + -을까요? → 어떨까요?，그렇다 + -으면 → 그러면）；若后面接以“-어/아/여”开头的词尾，“ㅎ”脱落，词干元音与词尾元音结合变成“애”（“하얗다”变为“하얘-”，如：빨개요、파래요、노래요、하얘요、까매요、어때요、이래요、저래요、그래요）。需要注意的是，形容词“좋다（好）”属于规则变化，不遵从此规则。",
      "examples": [
        { "kr": "어떤 색을 좋아합니까?", "cn": "你喜欢什么颜色？" },
        { "kr": "노란색을 싫어합니다.", "cn": "我不喜欢黄色。" },
        { "kr": "그러면 내일 만납시다.", "cn": "那么，我们明天见吧。" },
        { "kr": "까만 바지가 어떨까요?", "cn": "黑裤子怎么样？" }
      ]
    },
    {
      "id": "g6_6",
      "pattern": "V-어/아/여 주다(드리다)",
      "meaning": "给/为（某人）做……，请帮（我）……",
      "usage": "用于动词词干后，表示为某人做某事或请求对方为自己做某事。如果听话人或受惠对象是长辈或者上级，用敬语形式“-어/아/여 드리다”。动词词干末音节元音为“ㅏ”或“ㅗ”时用“-아 주다”，为其他元音时用“-어 주다”，以“하다”结尾时用“-여 주다”并通常缩写成“-해 주다”。",
      "examples": [
        { "kr": "전화번호 좀 알려 주십시오.", "cn": "请告诉我一下电话号码。" },
        { "kr": "이름을 써 주세요.", "cn": "请写一下你的名字。" },
        { "kr": "친구에게 우산을 빌려 주었어요.", "cn": "我把伞借给朋友了。" },
        { "kr": "누가 한국말을 가르쳐 주셨어요?", "cn": "谁教你韩语的？" },
        { "kr": "제가 도와 드리겠습니다.", "cn": "我来帮您。" }
      ]
    },
    {
      "id": "g6_7",
      "pattern": "단위 명사",
      "meaning": "单位名词（量词）与数词的搭配",
      "usage": "数事物时要在数词后面加上单位名词，每一种单位名词通常和特定的名词搭配使用。根据单位名词的不同，前面数词的读法分为两种：1）用固有数词“한、두、세、네……（하나、둘、셋、넷、스물 在单位名词前变为 한、두、세、네、스무）”的单位名词有：개（个，东西）、권（本，书/本子）、병（瓶，啤酒/水/可乐）、사람/명/분（人/名/位）、잔（杯，咖啡/茶/水/啤酒）、장（张，纸/邮票/票）、자루（支，铅笔/圆珠笔）、살（岁，年龄）、갑（包，香烟/火柴）、번（次，次数）、송이（朵/枝，花）、통（盒/封，口香糖/信/饼干）、대（辆/台，汽车/冰箱/电视）、켤레（双，鞋/袜子/手套）、벌（件/套，衣服）、마리（只/条，动物/鱼）、시간（小时）、달（个月）；2）用汉字数词“일、이、삼、사……”的单位名词有：층（楼/层，建筑）、호실（号，房间）、인분（人份，食物）、일（天）、주일（星期）、년（年）、원（元）等。",
      "examples": [
        { "kr": "연필 한 자루 주세요.", "cn": "请给我一支铅笔。" },
        { "kr": "맥주 두 병에 얼마예요?", "cn": "两瓶啤酒多少钱？" },
        { "kr": "공책이 몇 권 있습니까?", "cn": "有几个本子？" },
        { "kr": "집에서 개 두 마리하고 고양이 한 마리를 기릅니다.", "cn": "我家养了两条狗和一只猫。" },
        { "kr": "사탕 한 개하고 초콜릿 두 개를 샀습니다.", "cn": "我买了一块糖和两块巧克力。" }
      ]
    },
    {
      "id": "g6_8",
      "pattern": "N에게(한테/께)",
      "meaning": "给……，向……，对……（表示动作涉及的对象）",
      "usage": "助词，用于表示人或动物的体词后面，表示宾语或动作涉及的对象，通常和“주다（给）、보내다（寄）、가르치다（教）、빌려주다（借给）、전화하다（打电话）、선물하다（送礼）”这类动词连用。在口语中常用“한테”；如果对象是需要尊敬的长辈或上级时，要将“에게/한테”换成敬语体“께”（同时将动词“주다”换成敬语词“드리다”）。",
      "examples": [
        { "kr": "동생에게 편지를 보냈습니다.", "cn": "我给弟弟寄了一封信。" },
        { "kr": "친구한테 책을 빌려 주었습니다.", "cn": "我借给了朋友一本书。" },
        { "kr": "부모님께 전화를 했습니다.", "cn": "我给父母打电话了。" },
        { "kr": "저에게 한국말을 가르쳐 주세요.", "cn": "请教我韩语。" },
        { "kr": "그 이야기를 미선 씨한테 하지 마세요.", "cn": "不要和美善说那件事。" }
      ]
    },
    {
      "id": "g6_9",
      "pattern": "V-는, -은/ㄴ, -을/ㄹ (관형사형 어미²)",
      "meaning": "……的（动词定语词尾，分别表示现在、过去、将来）",
      "usage": "用于动词词干后面，修饰后面的体词充当定语。1）如果动作正在进行中或经常发生（现在时），无论词干有无收音均加“-는”（以“ㄹ”结尾时“ㄹ”脱落加“-는”）；2）如果该动作已经发生（过去时），有收音加“-은”，无收音加“-ㄴ”（以“ㄹ”结尾时“ㄹ”脱落加“-ㄴ”）；3）如果动作将要发生或表示对将来的推测、打算（将来时），有收音加“-을”，无收音加“-ㄹ”（以“ㄹ”结尾时直接以“ㄹ”作定语尾）。",
      "examples": [
        { "kr": "조금 전에 부른 노래 제목이 뭐예요?", "cn": "你刚刚唱的那首歌叫什么名字？" },
        { "kr": "제 친구 중에는 아직 결혼한 사람이 없어요.", "cn": "在我的朋友当中还没有结婚的。" },
        { "kr": "지금 일하는 회사가 어디예요?", "cn": "你在哪家公司上班？" },
        { "kr": "모르는 것이 있으면 질문하세요.", "cn": "如果有什么不明白的就问我吧。" },
        { "kr": "냉장고에 먹을 것이 하나도 없어요.", "cn": "冰箱里什么吃的都没有。" },
        { "kr": "만날 사람이 있어서 지금 시내에 갑니다.", "cn": "我要去市里见个人。" }
      ]
    }
  ],
  "dialogues": [
    {
      "section": "01 선물을 사러 갑시다 (我们去买礼物吧)",
      "lines": [
        {
          "speaker": "마리아",
          "korean": "오후에 선물을 사러 갑시다.",
          "chinese": "我们下午去买礼物吧。",
          "pronunciation_note": "연음·경음화 [선물을 -> 선무를, 갑시다 -> 갑씨다]"

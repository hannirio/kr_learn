  "grammar": [
    {
      "id": "g10_1",
      "pattern": "V-으려고/려고 하다",
      "meaning": "用于动词词干后面，表示计划或意图（打算做某事）",
      "usage": "用于动词词干后面，表示说话人的计划或意图。如果动词词干以辅音（有收音，除“ㄹ”外）结尾用“-으려고 하다”，以元音（无收音）或收音“ㄹ”结尾用“-려고 하다”。",
      "examples": [
        { "kr": "내일 대사관에 가려고 합니다.", "cn": "我打算明天去大使馆。" },
        { "kr": "오후 몇 시에 출발하려고 합니까?", "cn": "你打算下午几点出发？" },
        { "kr": "도서관에 가서 책을 읽으려고 합니다.", "cn": "我想去图书馆看书。" },
        { "kr": "우리 아들은 의사가 되려고 합니다.", "cn": "我儿子想当医生。" },
        { "kr": "김밥을 만들려고 합니다.", "cn": "我想做紫菜包饭。" }
      ]
    },
    {
      "id": "g10_2",
      "pattern": "N 동안",
      "meaning": "用于表示时间段的名词后面，意思是“……期间”",
      "usage": "附于表示时间段的名词（如“1년、2주、사흘、방학、학기”等）后面，表示某个动作或状态持续的时间长度，意为“在……期间”或“……（时间）里”。后面也可以接助词“에”构成“동안에”。",
      "examples": [
        { "kr": "1년 동안 한국말을 배웠어요.", "cn": "我学了一年的韩语了。" },
        { "kr": "사흘 동안에 생각이 달라졌어요.", "cn": "三天的时间我的想法改变了。" },
        { "kr": "얼마 동안 운동을 하실 거예요?", "cn": "你要锻炼多久？" },
        { "kr": "방학 동안 여행을 많이 하고 싶어요.", "cn": "假期我想去很多地方旅行。" },
        { "kr": "몇 달 동안 친구를 통 못 만났어요.", "cn": "这几个月我一直没见到我的朋友。" }
      ]
    },
    {
      "id": "g10_3",
      "pattern": "V/A-을/ㄹ 때, N 때",
      "meaning": "表示动作或状态发生的时间，意为“……的时候”",
      "usage": "用于谓词词干和体词谓词形后面，表示动作状态发生的时间。当词干末音节以辅音（有收音，除“ㄹ”外）结尾时用“-을 때”，以元音（无收音）或收音“ㄹ”结尾时用“-ㄹ 때”。如果表示某个动作状态已经结束，用过去时词尾“-았/었을 때”。名词后面不用“-을/ㄹ 때”，而直接用“N 때”（如“점심 때、시험 때、방학 때、크리스마스 때”）。",
      "examples": [
        { "kr": "저녁을 먹을 때 손님이 오셨어요.", "cn": "我们吃晚饭的时候，有客人来了。" },
        { "kr": "버스를 탈 때 조심하세요.", "cn": "坐公共汽车时，请小心一点。" },
        { "kr": "공항에 도착했을 때는 밤이었어요.", "cn": "到机场的时候，天已经黑了。" },
        { "kr": "시간이 있을 때는 여행을 가요.", "cn": "有时间的时候我去旅行。" },
        { "kr": "방학 때 설악산에 가려고 해요.", "cn": "放假时我打算去雪岳山。" }
      ]
    },
    {
      "id": "g10_4",
      "pattern": "N 중에서 (~ 제일/가장)",
      "meaning": "用于表示各种事物、对象的体词后面，意思是“在……当中（最……）”",
      "usage": "附于表示多个事物、范围或比较对象的体词后面，意为“在……当中”。常与副词“제일”或“가장”（最）搭配使用，表示在某一范围内程度最高或从中做出选择。",
      "examples": [
        { "kr": "한국 음식 중에서 무엇이 제일 맛이 있어요?", "cn": "你觉得韩国料理中什么最好吃？" },
        { "kr": "고기하고 생선 중에서 저는 생선을 좋아해요.", "cn": "肉和鱼当中，我更喜欢鱼。" },
        { "kr": "한국에 있는 산 중에서 설악산이 제일 유명해요.", "cn": "韩国的山当中，雪岳山最有名。" },
        { "kr": "이 중에서 사고 싶은 것을 고르세요.", "cn": "从这些里面挑你最想买的。" },
        { "kr": "운동 중에서 여름에 쉽게 할 수 있는 운동은 수영이에요.", "cn": "各项运动当中，夏天最容易做的就是游泳了。" }
      ]
    },
    {
      "id": "g10_5",
      "pattern": "N에 ~쯤",
      "meaning": "表示在一定的时间或数量基准内的大致估计，意为“每……大概/左右”",
      "usage": "“에”一般接在单位名词或可以作为单位的名词（如“하루、일주일、한 달、1년、세 개”等）后面，表示频率或计量的基准；后面常和“쯤”连用，表示对数量、频率、时间或价格的大致估计。",
      "examples": [
        { "kr": "하루에 8시간쯤 자요.", "cn": "我每天差不多睡8个小时。" },
        { "kr": "일주일에 한 번쯤 친구들을 만나요.", "cn": "我大概每周见一次朋友。" },
        { "kr": "1년에 두 번쯤 여행을 가요.", "cn": "我大概一年旅游两次。" },
        { "kr": "하루에 5개쯤 만들어요.", "cn": "我一天大概做五个。" },
        { "kr": "귤 세 개에 1,000원쯤 해요.", "cn": "三个橘子1000元左右。" }
      ]
    },
    {
      "id": "g10_6",
      "pattern": "못 V",
      "meaning": "主要用于动词前面的副词，表示“不能够”、“没有这种能力”",
      "usage": "置于动词前面，表示因能力不足或外部客观原因而“不能够”做某事。如果和“N하다”类动词连用，就放在“하다”的前面，写作“N(을/를) 못 하다”（当“못하다”作为独立动词表示“不擅长、做不好”时连写）。",
      "examples": [
        { "kr": "매운 음식을 못 먹어요.", "cn": "我不能吃辣。" },
        { "kr": "한자를 안 배워서 못 읽어요.", "cn": "我没学过汉字，所以不会读。" },
        { "kr": "어릴 때는 물이 무서워서 수영을 못 했어요.", "cn": "小时候我因为怕水，不会游泳。" },
        { "kr": "너무 피곤해서 시계 소리를 못 들었어요.", "cn": "我太累了，所以没听到闹铃响。" },
        { "kr": "한국은 교통이 너무 복잡해서 운전을 못하겠어요.", "cn": "因为韩国交通太复杂，所以我开不了车。" }
      ]
    },
    {
      "id": "g10_7",
      "pattern": "V-기 전에, N 전에",
      "meaning": "表示一个动作发生在另一个动作之前，意为“在……之前”",
      "usage": "“-기 전에”用于谓词（动词）词干后，不受词干收音限制，表示后一动作发生在前一动作之前。名词后面不用“-기 전에”，而直接用“N 전에”（如“10분 전에、한 달 전에、1년 전에”）。",
      "examples": [
        { "kr": "밥을 먹기 전에 손을 씻어요.", "cn": "吃饭前先洗手。" },
        { "kr": "한국에 오기 전에 한국말을 하나도 몰랐어요.", "cn": "我来韩国之前一点韩语也不会。" },
        { "kr": "수영을 하기 전에 준비 운동을 하세요.", "cn": "游泳之前请先做一下热身运动。" },
        { "kr": "여행하기 전에 준비할 게 많아요?", "cn": "去旅游之前要准备的东西多吗？" },
        { "kr": "물건을 사기 전에 계획을 세워요.", "cn": "买东西之前你要先计划好。" },
        { "kr": "10분 전에 전화가 왔어요.", "cn": "10分钟之前来电话了。" }
      ]
    },
    {
      "id": "g10_8",
      "pattern": "V-지 못하다",
      "meaning": "用于谓词词干后，表示“不能够”、“没有这种能力”",
      "usage": "附于动词词干后面（不受收音限制），是“못 V”的长形否定形式，表示由于能力不够或外部原因导致动作无法实现，意为“不能……”、“没能……”。时制词尾或尊敬词尾结合在“못하다”上。",
      "examples": [
        { "kr": "한자를 몰라서 신문을 읽지 못해요.", "cn": "我不认识汉字，所以读不了报纸。" },
        { "kr": "어제 잠을 잘 자지 못해서 피곤합니다.", "cn": "我昨晚没睡好，所以很疲倦。" },
        { "kr": "술은 한 방울도 마시지 못해요.", "cn": "我一点酒也不能喝。" },
        { "kr": "약속을 지키지 못해서 죄송합니다.", "cn": "对不起，我失约了。" },
        { "kr": "저는 노래를 잘 부르지 못합니다.", "cn": "我唱歌唱得不好。" }
      ]
    }
  ],
  "dialogues": [
    {
      "section": "01 설악산에 가려고 해요 (我打算去雪岳山)",
      "lines": [
        {

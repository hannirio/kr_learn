  "grammar": [
    {
      "id": "g5_1",
      "pattern": "N까지",
      "meaning": "到……（表示时间或地点的终点以及顺序的末尾）",
      "usage": "用于体词后面的助词，表示时间或地点的终点以及顺序的末尾，不论体词有无收音均直接接“까지”。",
      "examples": [
        { "kr": "종로까지 걸어갑니다.", "cn": "走到钟路。" },
        { "kr": "서울에서 부산까지 기차로 5시간 걸립니다.", "cn": "从首尔到釜山坐火车要5个小时。" },
        { "kr": "12시에서 1시까지 점심시간입니다.", "cn": "午餐时间是从12点到1点。" },
        { "kr": "몇 시까지 갑니까?", "cn": "你需要几点之前到那里？" },
        { "kr": "여기까지 하십시오.", "cn": "请做到这儿。" }
      ]
    },
    {
      "id": "g5_2",
      "pattern": "V/A-어요/아요/여요",
      "meaning": "非格式体尊敬阶终结词尾（可用于陈述句、疑问句、命令句或共动句）",
      "usage": "用于谓词词干和体词谓词形后，在表示尊敬的同时带有亲切柔和的语气。谓词词干末音节元音为“아, 오, 야”时接“-아요”；为其他元音时接“-어요”；以“하다”结尾时接“-여요”，通常缩写为“해요”。当词干以元音结尾且词尾以元音开始时，常发生元音省略或缩写（如 가아요→가요, 쓰어요→써요, 오아요→와요, 배우어요→배워요, 기다리어요→기다려요）。体词后接“이에요/예요”（有收音接“이에요”，无收音接“예요”）。",
      "examples": [
        { "kr": "지금 몇 시예요?", "cn": "现在几点？" },
        { "kr": "한 시 십 분이에요.", "cn": "一点十分。" },
        { "kr": "회사에 가요.", "cn": "我去公司。" },
        { "kr": "친구가 집에 와요.", "cn": "朋友来家里。" },
        { "kr": "한국어를 공부해요.", "cn": "学习韩语。" }
      ]
    },
    {
      "id": "g5_3",
      "pattern": "V/A-지요?",
      "meaning": "……吧？（表示说话人对所提问题已有了解，希望得到对方的确认）",
      "usage": "用于谓词词干和体词谓词形后面的终结词尾，表示说话人对所提问题已有把握或了解，只是希望得到听话人的确认。谓词词干不论有无收音直接接“-지요?”；体词有收音接“이지요?”，无收音接“지요?”。",
      "examples": [
        { "kr": "날씨가 덥지요?", "cn": "天气很热吧？" },
        { "kr": "선생님이 좋지요?", "cn": "老师很好吧？" },
        { "kr": "날마다 운동하시지요?", "cn": "每天都锻炼身体吧？" },
        { "kr": "내일 학교에 가지요?", "cn": "明天去学校吧？" },
        { "kr": "오늘이 목요일이지요?", "cn": "今天是星期四吧？" }
      ]
    },
    {
      "id": "g5_4",
      "pattern": "V/A-(으)세요",
      "meaning": "非格式体尊称终结词尾（用于尊敬主体，可用于陈述句、疑问句、命令句和共动句）",
      "usage": "在非格式体终结词尾“-어요/아요/여요”前面加上主体尊称先语末词尾“-(으)시-”缩合而成。如果前面的词干以元音结尾（无收音）或以收音“ㄹ”结尾（“ㄹ”脱落）用“-세요”；以其他辅音结尾（有收音）则用“-으세요”。",
      "examples": [
        { "kr": "이번에는 홍 선생님이 가세요.", "cn": "这次洪老师去。" },
        { "kr": "어떤 음식이 좋으세요?", "cn": "你喜欢什么样的食物？" },
        { "kr": "요즘 많이 바쁘세요?", "cn": "您最近忙吗？" },
        { "kr": "선생님, 여기 앉으세요.", "cn": "老师请坐这儿。" },
        { "kr": "저와 같이 가세요.", "cn": "请跟我走吧。" }
      ]
    },
    {
      "id": "g5_5",
      "pattern": "N에²",
      "meaning": "在……（表示动作或状况发生的时间）",
      "usage": "和表示时间的体词连用，表示某种动作或者状况发生的具体时间。注意：“에”不能与“언제（什么时候）、오늘（今天）、내일（明天）、어제（昨天）、그저께（前天）、모레（后天）”等时间词连用。",
      "examples": [
        { "kr": "9시에 학교에 갑니다.", "cn": "我九点去学校。" },
        { "kr": "12시에 점심을 먹었습니다.", "cn": "我十二点吃了午饭。" },
        { "kr": "내년에 대학교를 졸업합니다.", "cn": "我明年大学毕业。" },
        { "kr": "겨울에는 날씨가 춥습니다.", "cn": "冬天天气很冷。" },
        { "kr": "언제 한국에 오셨습니까?", "cn": "你是什么时候来到韩国的？" }
      ]
    },
    {
      "id": "g5_6",
      "pattern": "N부터 ~ N까지",
      "meaning": "从……到……（表示时间或范围的起点与终点）",
      "usage": "用于体词后，“부터”表示某一时间或范围的起点，“까지”表示某一范围的终点，相当于汉语的“从……到……”。",
      "examples": [
        { "kr": "아홉 시부터 한 시까지 공부합니다.", "cn": "我从九点到一点学习。" },

        { "kr": "도서관에 갈까요?", "cn": "我们去图书馆好吗？" },
        { "kr": "내일 만날까요?", "cn": "我们明天见面怎么样？" },
        { "kr": "무슨 영화를 볼까요?", "cn": "我们看什么电影好呢？" }
      ]
    },
    {

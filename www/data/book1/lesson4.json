        { "kr": "도서관 앞에서 만납시다.", "cn": "我们在图书馆前面见吧。" },
        { "kr": "영화를 봅시다.", "cn": "我们看电影吧。" },
        { "kr": "불고기를 시킵시다.", "cn": "我们点烤肉吧。" }

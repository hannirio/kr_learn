  "grammar": [
    {
      "id": "g4_1",
      "pattern": "N에 가다/오다",
      "meaning": "去/来某处（表示移动的目的地）",
      "usage": "当表示主体的存在处所的助词“에”和趋向动词“가다/오다（去/来）”等（以及“나가다、들어오다、올라가다、내려오다、다니다”等移动动词）连用时，“에”前边的处所名词就是动词的目的地。",
      "examples": [
        { "kr": "날마다 학교에 갑니다.", "cn": "我每天去学校。" },

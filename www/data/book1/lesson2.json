  "grammar": [
    {
      "id": "g2_1",
      "pattern": "N이/가",
      "meaning": "主格助词，附于体词后表示句子的主语",
      "usage": "用于体词后面的主格助词，表示句子的主语。如果体词末音节以辅音（有收音）结尾用“이”，以元音（无收音）结尾用“가”。此外，人称代词“나、너、저”及疑问代词“누구”与“가”结合后，分别变为“내가、네가、제가、누가”。",
      "examples": [
        { "kr": "이것이 책상입니다.", "cn": "这是桌子。" },
        { "kr": "여기가 학교입니다.", "cn": "这里是学校。" },
        { "kr": "이것이 책입니까?", "cn": "这是书吗？" },
        { "kr": "친구가 많습니다.", "cn": "朋友很多。" },
        { "kr": "의자가 없습니다.", "cn": "没有椅子。" },
        { "kr": "제가 김영수입니다.", "cn": "我是金英秀。" },
        { "kr": "누가 왔습니까?", "cn": "谁来了？" }
      ]
    },
    {
      "id": "g2_2",
      "pattern": "이, 그, 저",
      "meaning": "指示冠词“这、那”，用在名词前指定人或事物",
      "usage": "用在名词前面修饰名词：①“이”表示所谈论的人或事物离说话人很近，或说话人和听话人正在谈论的事实；②“그”表示所谈论的人或事物离听话人近、离说话人远，或双方之前提及过、都知道的人或事物；③“저”表示所谈论的人或事物离说话人和听话人都很远。",
      "examples": [
        { "kr": "이 책이 사전입니까?", "cn": "这本书是词典吗？" },
        { "kr": "이 연필이 제 연필입니다.", "cn": "这支铅笔是我的。" },
        { "kr": "그 책은 교과서입니다.", "cn": "那本书是课本。" },
        { "kr": "아까 그 남자가 누구입니까?", "cn": "刚刚说的那个男人是谁？" },
        { "kr": "나는 저 사람을 압니다.", "cn": "我认识那个人。" },
        { "kr": "저 건물이 우리 학교입니다.", "cn": "那栋楼是我们学校。" }
      ]
    },
    {
      "id": "g2_3",
      "pattern": "N도",
      "meaning": "补助词“也”，表示列举相同或相似的事物",
      "usage": "用于体词后面的助词，表示列举相同或相似的事物（相当于汉语的“也”），无论体词有无收音均接“도”。在与主格助词“이/가”、宾格助词“을/를”连用时，主格助词和宾格助词要省略；但当它与“에”或“에서”连用表示场所或位置时，“에、에서”不能省略（构成“에도、에서도”）。",
      "examples": [
        { "kr": "책상이 있습니다. 의자도 있습니다. 시계도 있습니다.", "cn": "有桌子，也有椅子，也有钟。" },
        { "kr": "책이 많습니다. 그림도 많습니다.", "cn": "书很多，画也很多。" },
        { "kr": "학교가 큽니다. 교실도 큽니다.", "cn": "学校很大，教室也很大。" },
        { "kr": "산에 갑니다. 바다에도 갑니다.", "cn": "我去爬山，也去海边。" },
        { "kr": "도서관에서 공부합니다. 집에서도 공부합니다.", "cn": "我在图书馆学习，也在家学习。" }
      ]
    },
    {
      "id": "g2_4",
      "pattern": "있다 / 없다",
      "meaning": "表示“有、在”（있다）与其否定形式“没有、不在”（없다）",
      "usage": "“있다”表示事物的所有（“有”）或所处的位置（“在”），其反义否定形式是“없다”，表示“没有、不在”，正式尊敬阶陈述式为“있습니다 / 없습니다”，疑问式为“있습니까? / 없습니까?”。如果主语是需要表示尊敬的长辈或上级，表示“在/不在”时用“계시다 / 안 계시다”。",
      "examples": [
        { "kr": "친구가 있습니다.", "cn": "我有朋友。" },
        { "kr": "시계가 있습니다.", "cn": "我有表。" },
        { "kr": "그림이 없습니다.", "cn": "没有画儿。" },
        { "kr": "질문이 있습니까?", "cn": "你有问题吗？" },
        { "kr": "돈이 없습니까?", "cn": "你没有钱吗？" },
        { "kr": "선생님이 계십니다.", "cn": "老师在。" }
      ]
    },
    {
      "id": "g2_5",
      "pattern": "N에¹ (场所)",
      "meaning": "处所格助词，附于场所或方位名词后表示主体的存在处所（“在……”）",
      "usage": "和表示场所、位置或方位的体词连用，表示人或事物所存在的处所，通常与存在谓词“있다（在/有）”、“없다（不在/没有）”以及“많다（多）”、“적다（少）”等连用，构成“N1에 N2이/가 있습니다/없습니다”或“N1이/가 N2에 있습니다/없습니다”句型。",
      "examples": [
        { "kr": "친구가 미국에 있습니다.", "cn": "我的朋友在美国。" },
        { "kr": "교실에 텔레비전이 없습니다.", "cn": "教室里没有电视。" },
        { "kr": "고양이가 방에 없습니다.", "cn": "猫不在房间里。" },

  "grammar": [
    {
      "id": "g1_1",
      "pattern": "N입니다",
      "meaning": "是……（正式尊敬阶陈述句终结形式）",
      "usage": "“이다”不能单独放在句尾，必须附于体词（名词、代词等）后面充当句子的谓语，用来表示事物的身份、状态或指定某个事物。“입니다”通常用于正式场合，无论体词有无收音均直接接续，发音时鼻音化读作“[임니다]”。",
      "examples": [
        { "kr": "이것은 제 책상입니다.", "cn": "这是我的书桌。" },
        { "kr": "저는 학생입니다.", "cn": "我是学生。" },
        { "kr": "이 아이가 제 딸입니다.", "cn": "这个小孩儿是我的女儿。" },
        { "kr": "여기가 우리 집입니다.", "cn": "这儿是我家。" },
        { "kr": "그분은 의사입니다.", "cn": "那位是医生。" }
      ]
    },
    {
      "id": "g1_2",
      "pattern": "N은/는",
      "meaning": "表示句子所陈述的主体、要讨论的话题，或表示对比与强调（补助词）",
      "usage": "用于体词后面的补助词，表示句子陈述的主题或对比、强调。如果体词以辅音（有收音）结尾用“은”，以元音（无收音）结尾用“는”。当“은/는”加在主格助词“이/가”或宾格助词“을/를”后面时，主格助词或宾格助词要省略；但附于其他助词（如“에、에서、에게”等）之后时，该助词不能省略。",
      "examples": [
        { "kr": "서울은 한국의 수도입니다.", "cn": "首尔是韩国的首都。" },
        { "kr": "저는 한국 사람입니다.", "cn": "我是韩国人。" },
        { "kr": "동생은 키가 큽니다. 저는 키가 작습니다.", "cn": "妹妹个子高，我个子矮。" },
        { "kr": "고기를 좋아합니다. 생선은 싫어합니다.", "cn": "我喜欢肉，不喜欢鱼。" },
        { "kr": "도서관에는 언제 갔습니까?", "cn": "你是什么时候去图书馆的？" }
      ]
    },
    {
      "id": "g1_3",
      "pattern": "N입니까?",
      "meaning": "是……吗？（“N입니다”的疑问形式）",
      "usage": "附于体词（名词、代词等）后面，是“입니다”的正式尊敬阶疑问形式，“?”置于句尾，句末读升调。发音时鼻音化读作“[임니까]”。",
      "examples": [
        { "kr": "이분이 어느 나라 사람입니까?", "cn": "这位是哪国人？" },
        { "kr": "지금이 두 시입니까?", "cn": "现在是两点吗？" },
        { "kr": "여기가 신촌입니까?", "cn": "这里是新村吗？" },
        { "kr": "이 책은 누구 책입니까?", "cn": "这本书是谁的？" },
        { "kr": "오늘이 며칠입니까?", "cn": "今天几号？" }
      ]
    },
    {
      "id": "g1_4",
      "pattern": "N이/가 아니다",
      "meaning": "不是……（“이다”的否定形式）",
      "usage": "和体词连用，是“이다”的否定形式（在正式场合常表现为“N이/가 아닙니다”）。如果体词以辅音（有收音）结尾用“이 아니다”，以元音（无收音）结尾用“가 아니다”。",
      "examples": [
        { "kr": "저는 일본 사람이 아닙니다.", "cn": "我不是日本人。" },
        { "kr": "존슨 씨는 의사가 아닙니다.", "cn": "约翰不是医生。" },
        { "kr": "이것은 교과서가 아닙니다.", "cn": "这不是课本。" },
        { "kr": "린다 씨는 선생님이 아닙니다.", "cn": "琳达不是老师。" },
        { "kr": "우리 어머니는 한국 사람이 아닙니다.", "cn": "我妈妈不是韩国人。" }
      ]
    },
    {
      "id": "g1_5",
      "pattern": "V/A-습니다/ㅂ니다",
      "meaning": "正式尊敬阶陈述句终结词尾，用于向对方解释或描述一个具体的动作或状态",
      "usage": "和谓词（动词、形容词）词干连用。如果谓词词干以元音（无收音）结尾用“-ㅂ니다”，以辅音（有收音）结尾则用“-습니다”。发音时“ㅂ”遇“ㄴ”发生鼻音化，读作“[-씀니다/-ㅁ니다]”。",
      "examples": [
        { "kr": "학교에 갑니다.", "cn": "我去学校。" },
        { "kr": "저는 키가 큽니다.", "cn": "我个子很高。" },
        { "kr": "만나서 반갑습니다.", "cn": "见到你很高兴。" },
        { "kr": "책이 있습니다.", "cn": "有书。" },
        { "kr": "의자가 없습니다.", "cn": "没有椅子。" }
      ]
    },
    {
      "id": "g1_6",
      "pattern": "V/A-습니까/ㅂ니까?",
      "meaning": "正式尊敬阶疑问句终结词尾，表示对具体的动作或状态的疑问",
      "usage": "和谓词（动词、形容词）词干连用，是“-습니다/ㅂ니다”的疑问形式。如果谓词词干以元音（无收音）结尾用“-ㅂ니까?”，以辅音（有收音）结尾则用“-습니까?”。句尾读升调，发音时鼻音化读作“[-씀니까/-ㅁ니까]”。",
      "examples": [
        { "kr": "무엇을 합니까?", "cn": "你做什么？" },
        { "kr": "어디에 갑니까?", "cn": "你去哪里？" },
        { "kr": "사전이 있습니까?", "cn": "有词典吗？" },
        { "kr": "한국 친구가 없습니까?", "cn": "你没有韩国朋友吗？" },
        { "kr": "시간이 많습니까?", "cn": "你的时间多吗？" }
      ]
    }
  ],

  "exercises": [
    {
      "id": "e1_1",
      "type": "choice",
      "question": "빈칸에 알맞은 것을 고르십시오: 저(   ) 김미선입니다.",
      "options": ["은", "는", "이", "을"],
      "answer_index": 1,
      "explanation": "体词“저（我）”以元音结尾（无收音），后面接表示主题的补助词时应使用“는”。"
    },
    {
      "id": "e1_2",
      "type": "choice",
      "question": "빈칸에 알맞은 것을 고르십시오: 선생님 이름(   ) 존슨입니다.",
      "options": ["은", "는", "가", "를"],
      "answer_index": 0,
      "explanation": "体词“이름（名字）”以辅音“ㅁ”结尾（有收音），后面接补助词“은/는”时应选择“은”。"
    },
    {
      "id": "e1_3",
      "type": "choice",
      "question": "빈칸에 알맞은 것을 고르십시오: 제 친구(   ) 마이클입니다.",

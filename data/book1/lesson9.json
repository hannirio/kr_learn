  "grammar": [
    {
      "id": "g9_1",
      "pattern": "-는데, -은데/ㄴ데",
      "meaning": "表示对立、转折或交代背景的连接词尾",
      "usage": "用于谓词词干和体词谓词形后面的连接词尾，表示对立、转折（也可用于引出下文或交代背景）。动词词干及“있다/없다”后面用“-는데”；形容词词干以辅音（除“ㄹ”外）结尾时用“-은데”，以元音或辅音“ㄹ”结尾时用“-ㄴ데”（“ㄹ”脱落）；体词谓词形后面用“-ㄴ데”。（注：句尾加“요”构成“-는데요/-은데요/ㄴ데요”可用作终结词尾，表示委婉陈述新发现的事实并期待对方回应。）",
      "examples": [
        { "kr": "저는 농구를 좋아하는데 친구들은 야구를 좋아합니다.", "cn": "我喜欢篮球，但是我的朋友们喜欢棒球。" },
        { "kr": "서울은 복잡한데 여기는 그렇지 않군요.", "cn": "首尔很拥挤，但这里不是啊。" },
        { "kr": "저는 영화를 보고 싶은데 친구들은 연극을 보고 싶어해요.", "cn": "我想看电影，但是我的朋友们想看戏剧。" },
        { "kr": "내일 시험을 보는데 공부하기가 싫어요.", "cn": "明天考试，但是我不想学习。" },
        { "kr": "친구는 많은데 이야기할 사람이 없어요.", "cn": "我朋友很多，但是没有可以说说话的人。" }
      ]
    },
    {
      "id": "g9_2",
      "pattern": "-을/ㄹ 수 있다/없다",
      "meaning": "能/不能……，可以/不可以……（表示能力或可能性）",
      "usage": "和谓词词干及体词谓词形连用，用来表示有做某事的能力或有某种可能性。其否定形式为“-을/ㄹ 수 없다”。如果前面词干以辅音（除“ㄹ”外）结尾用“-을 수 있다/없다”，以元音或辅音“ㄹ”结尾用“-ㄹ 수 있다/없다”（以“ㄹ”结尾时原“ㄹ”合并）。",
      "examples": [
        { "kr": "나도 한국말을 할 수 있습니다.", "cn": "我也会说韩语。" },
        { "kr": "내일은 한가하니까 갈 수 있어요.", "cn": "我明天有空，可以去。" },
        { "kr": "여기서 좌회전을 할 수 있습니까?", "cn": "可以在这里左转吗？" },
        { "kr": "한국 신문은 어려워서 읽을 수 없습니다.", "cn": "韩语报纸太难，我读不懂。" },
        { "kr": "길이 복잡해서 운전할 수 없습니다.", "cn": "路况太复杂了，我开不了车。" }
      ]
    },
    {
      "id": "g9_3",
      "pattern": "-은/ㄴ 후에 (N 후에)",
      "meaning": "在……之后，……以后",
      "usage": "用于动词词干后面，表示前一个动作完成之后，后一个动作又开始。如果动词词干以辅音（除“ㄹ”外）结尾用“-은 후에”，以元音或辅音“ㄹ”结尾用“-ㄴ 후에”（以“ㄹ”结尾时“ㄹ”脱落）。体词后面不用“-은/ㄴ 후에”，而直接用“N 후에”。",
      "examples": [
        { "kr": "식사한 후에 차를 마십니다.", "cn": "吃完饭以后喝茶。" },
        { "kr": "내 말을 들은 후에 질문하세요.", "cn": "请听我讲完以后再提问。" },
        { "kr": "학교를 졸업한 후에 뭘 하시겠어요?", "cn": "你毕业以后想做什么？" },
        { "kr": "30분 후에 다시 걸겠습니다.", "cn": "30分钟后再给你打电话吧。" },
        { "kr": "퇴근 후에 한잔 합니다.", "cn": "下班后去喝杯酒。" },
        { "kr": "일 년 후에 결혼하겠어요.", "cn": "我一年后要结婚。" }
      ]
    },
    {
      "id": "g9_4",
      "pattern": "-겠-²",
      "meaning": "应该……，一定……吧（表示推测）",
      "usage": "用于谓词词干和体词谓词形后面的先语末词尾（词缀），表示说话人对某种客观情况、他人状态或未来事件的推测。无论前面词干有无收音，均直接接“-겠-”。",
      "examples": [
        { "kr": "제목을 보니까 이 영화가 재미있겠어요.", "cn": "看名字，这部电影应该很有趣。" },
        { "kr": "주말이라서 교통이 복잡하겠어요.", "cn": "因为是周末，所以交通一定很拥挤。" },
        { "kr": "일이 많아서 금방 끝내기가 힘들겠어요.", "cn": "要做的事太多了，想在短时间内完成应该很困难。" },
        { "kr": "피아노를 잘 치니까 훌륭한 음악가가 되겠어요.", "cn": "你钢琴弹得这么好，一定会成为一名优秀的钢琴家。" },
        { "kr": "하늘을 보니까 오후에는 비가 오겠어요.", "cn": "看天空，下午应该会下雨。" }
      ]
    },
    {
      "id": "g9_5",
      "pattern": "N보다",
      "meaning": "比……（表示比较的对象）",
      "usage": "和体词连用的助词，用于两个事物之间的比较。无论体词有无收音均直接接“보다”，“보다”前面是被比较的基准对象，谓语前常搭配副词“더（更）”一起使用。",
      "examples": [
        { "kr": "언니가 동생보다 커요.", "cn": "姐姐比妹妹高。" },
        { "kr": "한국말이 영어보다 더 어려워요.", "cn": "韩语比英语难。" },
        { "kr": "어제보다 오늘이 더 추워요.", "cn": "今天比昨天冷。" },
        { "kr": "저는 불고기보다 갈비를 더 좋아해요.", "cn": "比起烤肉，我更喜欢吃排骨。" },
        { "kr": "지하철이 버스보다 더 빨라요.", "cn": "地铁比公共汽车快。" }
      ]
    },
    {
      "id": "g9_6",
      "pattern": "-을/ㄹ 것 같다",
      "meaning": "好像要……，大概会……（表示推测）",
      "usage": "用于谓词词干后，表示对将要发生的事情或某种状态的推测。如果谓词词干以辅音（除“ㄹ”外）结尾用“-을 것 같다”，以元音或辅音“ㄹ”结尾用“-ㄹ 것 같다”。此外，对正在进行的动作或当前事实的推测用“-는 것 같다”，对已完成的动作或当前形容词状态的推测用“-ㄴ/은 것 같다”。",
      "examples": [
        { "kr": "너무 배가 고파서 많이 먹을 것 같아요.", "cn": "我好饿，应该能吃很多。" },
        { "kr": "곧 비가 올 것 같아요.", "cn": "看起来马上要下雨了。" },
        { "kr": "미선 씨는 목소리가 예뻐서 노래를 잘 부를 것 같아요.", "cn": "美善的嗓子很好，唱歌应该很好听。" },
        { "kr": "이 음식은 너무 매울 것 같아요.", "cn": "这个东西看起来很辣。" },
        { "kr": "이번 시험이 어려울 것 같아요.", "cn": "这次考试好像会很难。" }
      ]
    },
    {
      "id": "g9_7",
      "pattern": "-는군요/군요",
      "meaning": "……啊！原来……！（表示感叹、评价或判断）",
      "usage": "用于谓词词干和体词谓词形后面的终结词尾，表示说话人刚意识到某事时的感叹、评价或判断。动词词干（及“있다/없다”）后面用“-는군요”；形容词词干、体词谓词形（-(이)군요）以及过去时制词尾“-었/았/였-”或推测词尾“-겠-”后面用“-군요”。",
      "examples": [
        { "kr": "매운 음식을 잘 잡수시는군요.", "cn": "你真能吃辣！" },

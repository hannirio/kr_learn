  "grammar": [
    {
      "id": "g7_1",
      "pattern": "N으로/로¹",
      "meaning": "往……，向……（表示移动方向或目的地的助词）",
      "usage": "用于处所或方向名词后面的助词，表示移动方向或目的地。后面通常接“가다（去）、오다（来）、돌아가다（回去）、돌아오다（回来）、나가다（出去）、나오다（出来）、내려가다（下去）”等移动动词。当名词以除“ㄹ”以外的辅音（有收音）结尾时用“으로”，以元音（无收音）或收音“ㄹ”结尾时用“로”。",
      "examples": [
        { "kr": "어디로 가십니까?", "cn": "您去哪里？" },
        { "kr": "사무실로 갑니다.", "cn": "我去办公室。" },
        { "kr": "식당으로 갑시다.", "cn": "我们去食堂吧。" },
        { "kr": "잠실역 6번 출구로 나가서 왼쪽으로 가세요.", "cn": "从蚕室站六号出口出去，然后向左转。" },
        { "kr": "아래층으로 내려가세요.", "cn": "请下到楼下。" }
      ]
    },
    {
      "id": "g7_2",
      "pattern": "V-어서/아서/여서¹",
      "meaning": "……之后，……着（表示动作先后顺序或方式状态的连接词尾）",
      "usage": "用于谓词词干后面的连接词尾，表示后一个动作或状态在前一个动作形成的情况下发生或进行（前后分句的主语必须一致，且两个动作有紧密的先后承接或方式关系）。词干末音节元音为“ㅏ、ㅗ”时用“-아서”，末音节元音为其他元音时用“-어서”，以“하다”结尾时用“-여서”（一般缩写成“해서”）。注意前面不能加过去时制词尾“-었/았/였-”或将来时制词尾“-겠-”。",
      "examples": [
        { "kr": "야채를 씻어서 냉장고에 넣었습니다.", "cn": "我把蔬菜洗好放进冰箱里了。" },
        { "kr": "편지를 써서 부쳤습니다.", "cn": "我写完信寄了出去。" },
        { "kr": "여기에 앉아서 기다리십시오.", "cn": "请你坐这等一下吧。" },
        { "kr": "집에 가서 점심을 먹습니다.", "cn": "我回家吃饭。" },
        { "kr": "아침에 일어나서 운동을 하세요?", "cn": "你早上起床后锻炼身体吗？" }
      ]
    },
    {
      "id": "g7_3",
      "pattern": "N으로/로²",
      "meaning": "用……，乘/坐……，以……（表示手段、工具、方式、材料、原因等的助词）",
      "usage": "附于体词（名词）后面，表示进行某动作所使用的交通工具、工具、手段、语言、原材料或方式等。体词以除“ㄹ”以外的辅音（有收音）结尾时用“으로”，以元音（无收音）或收音“ㄹ”结尾时用“로”。",
      "examples": [
        { "kr": "젓가락으로 먹습니다.", "cn": "我用筷子吃。" },
        { "kr": "한국말로 말하십시오.", "cn": "请用韩语说。" },
        { "kr": "버스로 왔습니다.", "cn": "坐公共汽车来的。" },
        { "kr": "연필로 씁니다.", "cn": "用铅笔写。" },
        { "kr": "김치는 배추로 만듭니다.", "cn": "泡菜是用白菜做的。" }
      ]
    },
    {
      "id": "g7_4",
      "pattern": "N에서 N까지",
      "meaning": "从……到……（表示处所或时间的起点与终点）",
      "usage": "用于表示时间、处所的体词后面，“에서”表示起点，“까지”表示终点，类似于汉语的“从……到……”。口语中“여기에서、거기에서、저기에서”常缩略为“여기서、거기서、저기서”。",
      "examples": [
        { "kr": "여기서 종로까지 걷습니다.", "cn": "我从这里走到钟路。" },
        { "kr": "서울에서 부산까지 기차로 5시간 걸립니다.", "cn": "从首尔到釜山坐火车需要五个小时。" },
        { "kr": "1층에서 5층까지 교실입니다.", "cn": "从一楼到五楼是教室。" },
        { "kr": "12시에서 1시까지 점심시간입니다.", "cn": "从12点到1点是午餐时间。" },
        { "kr": "저녁 7시에서 9시까지 식당에서 아르바이트를 합니다.", "cn": "从晚上7点到9点在餐厅打工。" }
      ]
    },
    {
      "id": "g7_5",
      "pattern": "V/A-어서/아서/여서²",
      "meaning": "因为……所以……（表示客观原因或理由的连接词尾）",
      "usage": "用于谓词词干或体词谓词形（N이어서/여서）后面的连接词尾，表示前句是后句的原因。当词干末音节元音为“ㅏ、ㅗ”时接“-아서”，为其他元音时接“-어서”，“하다”变为“해서”。需要注意：表示原因时，终结谓语不能用命令句（-으십시오/-으세요）或共动句（-읍시다）；另外，时制词尾“-었/았/였-”和“-겠-”不能用于“-어서/아서/여서”的前面。",
      "examples": [
        { "kr": "한국이 좋아서 한국에 왔습니다.", "cn": "我喜欢韩国，所以来到韩国。" },
        { "kr": "배가 아파서 약을 먹었습니다.", "cn": "我肚子疼，所以吃了点药。" },
        { "kr": "옷을 많이 입어서 덥습니다.", "cn": "我衣服穿多了，所以觉得很热。" },
        { "kr": "약속을 안 지켜서 죄송합니다.", "cn": "我失约了，真对不起。" },
        { "kr": "피곤해서 일찍 집에 갔습니다.", "cn": "因为很累，所以提前回家了。" }
      ]
    },
    {
      "id": "g7_6",
      "pattern": "V/A-으니까/니까",
      "meaning": "因为……所以……；一……发现……（表示原因、判断依据或发现的连接词尾）",
      "usage": "和谓词词干或体词谓词形（N이니까/니까）连用的连接词尾，表示前句是后句的原因，或进行前面的动作后才知道后面的状况。如果前面词干音节以元音或收音“ㄹ”结尾（“ㄹ”脱落，如 멀다 -> 머니까）用“-니까”，以其他辅音结尾用“-으니까”。与“-어서²”不同，“-으니까/니까”的后句可以使用命令句和共动句，且前句可以结合过去时制词尾“-었/았/였-”。",
      "examples": [
        { "kr": "오늘은 일이 많으니까 내일 만납시다.", "cn": "今天有很多事情要做，我们明天见吧。" },
        { "kr": "날씨가 추우니까 안으로 들어가세요.", "cn": "天气很冷，进去吧。" },
        { "kr": "담배는 건강에 나쁘니까 피우지 마십시오.", "cn": "吸烟有害健康，请不要吸烟。" },
        { "kr": "오늘은 눈이 많이 오니까 자동차를 운전하지 마세요.", "cn": "今天雪下得很大，请不要开车。" },
        { "kr": "사람이 많으니까 조심하세요.", "cn": "人很多，小心一点。" }
      ]
    },
    {
      "id": "g7_7",
      "pattern": "V-지 말다",
      "meaning": "不要……，别……（表示对行为的禁止或劝阻）",
      "usage": "和动词词干连用，表示对行为的禁止或劝阻，类似于汉语的“不要”“别”。它是命令句（-으십시오/-으세요）和共动句（-읍시다）的否定形式：命令句中用“-지 마십시오”或“-지 마세요”，共动句中用“-지 맙시다”。",
      "examples": [
        { "kr": "건물 안에서 담배를 피우지 마십시오.", "cn": "请不要在楼里吸烟。" },
        { "kr": "도서관에서 떠들지 마세요.", "cn": "请不要在图书馆里喧哗。" },
        { "kr": "박물관에서 사진을 찍지 마십시오.", "cn": "请不要在博物馆里拍照。" },
        { "kr": "교실에서 영어로 말하지 맙시다.", "cn": "我们不要在教室里说英语了。" },
        { "kr": "쓰레기를 버리지 맙시다.", "cn": "我们不要乱扔垃圾。" }
      ]
    },
    {
      "id": "g7_8",
      "pattern": "ㄷ 불규칙 용언",
      "meaning": "‘ㄷ’特殊音变（‘ㄷ’不规则谓词）",
      "usage": "以收音“ㄷ”结尾的部分谓词词干（如“듣다 听、묻다 问、걷다 走、싣다 装运”等）和以元音开头的词尾（如“-어요/아요、-어서/아서、-으니까、-으세요”等）连接时，收音“ㄷ”变成“ㄹ”（如：듣 + 어서 -> 들어서；걷 + 어요 -> 걸어요）。需要注意的是，“받다（收到）、믿다（相信）、얻다（得到）、닫다（关）”等词虽然也以“ㄷ”结尾，但属于规则变化，故不遵从此规则。",
      "examples": [
        { "kr": "음악을 들으니까 기분이 좋아요.", "cn": "听了音乐，心情很好。" },
        { "kr": "저는 잘 모르니까 다른 사람에게 물어 보세요.", "cn": "我不清楚，请问别人吧。" },
        { "kr": "집에서 학교까지 걸어서 10분 걸립니다.", "cn": "我从家到学校走路需要10分钟。" },
        { "kr": "이삿짐은 자동차 뒤에 실으세요.", "cn": "请把行李搬到汽车上去。" },
        { "kr": "추우니까 문 좀 닫아 주세요.", "cn": "好冷啊，请关上门吧。" }
      ]
    },
    {
      "id": "g7_9",
      "pattern": "르 불규칙 용언",
      "meaning": "‘르’特殊音变（‘르’不规则谓词）",
      "usage": "词干末音节以“르”结尾的大部分谓词（如“모르다 不知道、빠르다 快、고르다 挑选、부르다 饱/唱/叫、다르다 不同、흐르다 流”等），如果后面接“-어/아-”开头的词尾，那么“르”中的元音“ㅡ”脱落，同时在“르”前面的音节上添加收音“ㄹ”（若前一音节元音为“ㅏ、ㅗ”则接“-아”，如 모르 + 아서 -> 몰라서；若为其他元音则接“-어”，如 부르 + 어서 -> 불러서）。",
      "examples": [
        { "kr": "배가 불러서 못 먹겠어요.", "cn": "我饱了，再也吃不下了。" },
        { "kr": "지하철이 버스보다 더 빨라요.", "cn": "地铁比公共汽车快。" },
        { "kr": "감기에 걸려서 자꾸 콧물이 흘러요.", "cn": "我感冒了，一直流鼻涕。" },
        { "kr": "처음에는 한국말을 하나도 몰랐어요.", "cn": "刚开始时，我一句韩语都不会说。" },
        { "kr": "어릴 때는 동생하고 얼굴이 아주 달랐어요.", "cn": "小时候，我弟弟和我长得一点也不像。" }
      ]
    }
  ],
  "dialogues": [
    {
      "section": "01 실례지만 길 좀 묻겠습니다 (劳驾，我想问一下路)",
      "lines": [
        {
          "speaker": "제임스",
          "korean": "실례지만 길 좀 묻겠습니다.",
          "chinese": "劳驾，我想问一下路。",
          "pronunciation_note": "경음화·비음화 [묻겠습니다 -> 묻껟씀니다]"
        },
        {
          "speaker": "남자",
          "korean": "어딜 찾으세요?",
          "chinese": "你要找哪里？",
          "pronunciation_note": "연음 [찾으세요 -> 차즈세요]"
        },
        {
          "speaker": "제임스",
          "korean": "연세 아파트가 어디에 있습니까?",
          "chinese": "延世公寓在哪？",
          "pronunciation_note": "경음화·비음화 [있습니까 -> 이씀니까]"
        },
        {
          "speaker": "남자",

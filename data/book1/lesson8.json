  "grammar": [
    {
      "id": "g8_1",
      "pattern": "V-을게요/ㄹ게요",
      "meaning": "表示说话人的意志、誓言或决定（我将要……，我会……的）",
      "usage": "用于动词词干后面的终结词尾，表示说话人向听话人做出承诺、表达自己的意志或决定。主语只能是第一人称（저/나/우리），不能用于疑问句。动词词干以辅音（有收音）结尾时用“-을게요”，以元音（无收音）或收音“ㄹ”结尾时用“-ㄹ게요”（发音时读作“[-을께요/-ㄹ께요]”）。",
      "examples": [
        { "kr": "이 책을 살게요.", "cn": "我买这本书。" },
        { "kr": "이따가 전화할게요.", "cn": "等一会儿我会给你打电话的。" },
        { "kr": "내일은 꼭 일찍 올게요.", "cn": "明天我一定会早点来的。" },
        { "kr": "이번 일은 제가 도와 드릴게요.", "cn": "这件事情，我会帮助你的。" },
        { "kr": "여기서는 담배를 피우지 않을게요.", "cn": "我不会在这里抽烟的。" }
      ]
    },
    {
      "id": "g8_2",
      "pattern": "N이나/나",
      "meaning": "或者（表示从罗列的两个或两个以上的事物中选择一个）",
      "usage": "用于体词（名词、代词、数词等）后面的助词，连接两个或两个以上的体词，表示从中任选其一。前面的体词以辅音（有收音）结尾时用“이나”，以元音（无收音）结尾时用“나”。",
      "examples": [
        { "kr": "주말에는 농구나 축구를 합시다.", "cn": "我们周末一起打篮球或者踢足球吧。" },
        { "kr": "오늘 두 시나 세 시쯤에 전화해 주세요.", "cn": "今天下午两三点左右请给我打电话。" },
        { "kr": "지하철이나 버스를 타고 학교에 갑니다.", "cn": "我坐地铁或者公共汽车去学校。" },
        { "kr": "요즘 바빠서 영화나 연극을 볼 시간이 없어요.", "cn": "我最近很忙，所以没有时间看电影或者戏剧。" },
        { "kr": "이번 여름에는 산이나 바다에 가고 싶어요.", "cn": "这个夏天我想去爬山或者去海边。" }
      ]
    },
    {
      "id": "g8_3",
      "pattern": "V/A-는데요, -은데요/ㄴ데요",
      "meaning": "……呢（表示说话人叙述某一状况并期待得到对方的回应）",
      "usage": "用于谓词词干和体词谓词形（N이다）后面的非格式体尊敬阶终结词尾，用于委婉地说明背景情况、温和地反驳或引起话题并期待对方回应。动词词干以及“있다/없다”、过去时“-았/었-”后面均用“-는데요”；形容词词干以元音（无收音）或收音“ㄹ”结尾时用“-ㄴ데요”，以辅音（有收音）结尾时用“-은데요”（“ㅂ”不规则形容词脱去“ㅂ”加“-운데요”）；体词谓词形后面用“N인데요”。",
      "examples": [
        { "kr": "이 시험은 좀 어려운데요.", "cn": "这次考试有点难。" },
        { "kr": "이 옷이 잘 어울리는데요.", "cn": "这件衣服很适合你。" },
        { "kr": "저는 신촌에 사는데요.", "cn": "我住在新村。" },
        { "kr": "시간이 좀 오래 걸리는데요.", "cn": "需要的时间稍长一点。" },
        { "kr": "바로 전데요. 누구세요?", "cn": "我就是，您是哪位？" }
      ]
    },
    {
      "id": "g8_4",
      "pattern": "N에게서/한테서",
      "meaning": "从（某人那里）……（表示动作或状态的出发点）",
      "usage": "用于活动体体词（人或动物名词）后面的副词格助词，表示某动作或状态的来源、出发点，通常与“배우다（学）、듣다（听）、받다（收到/接到）、빌리다（借）、오다（来）”这类动词搭配使用，意思相当于“으로부터（从）”。其中“한테서”更常用于口语。在口语中“서”有时也可省略为“에게/한테”。",
      "examples": [
        { "kr": "선생님한테서 한국말을 배웁니다.", "cn": "我跟老师学习韩语。" },
        { "kr": "친구한테서 그 이야기를 들었어요.", "cn": "我从朋友那儿听说的。" },
        { "kr": "이거 누구한테서 받았어요?", "cn": "你从谁那儿收到的？" },
        { "kr": "고향에 계시는 부모님에게서 편지가 왔어요.", "cn": "远在家乡的父母给我来信了。" },
        { "kr": "친한 친구에게서 돈을 빌렸어요.", "cn": "我从好朋友那儿借了钱。" }
      ]
    },
    {
      "id": "g8_5",
      "pattern": "V/A-으면/면",
      "meaning": "如果……的话，要是……就……（表示假设条件的连接词尾）",
      "usage": "用于谓词词干和体词谓词形（N이다）后面的连接词尾，表示前句是后句的假设或前提条件。如果词干末音节以元音（无收音）或收音“ㄹ”结尾时用“-면”，以“ㄹ”以外的辅音（有收音）结尾时用“-으면”。",
      "examples": [
        { "kr": "바쁘지 않으면 내일 만날까요?", "cn": "如果你明天不忙，我们可以见个面吗？" },
        { "kr": "내일 날씨가 좋으면 설악산에 갑시다.", "cn": "如果明天天气好的话，我们一起去雪岳山吧。" },
        { "kr": "많이 아프면 학교에 오지 마세요.", "cn": "如果你病得很重，就不要来学校了。" },
        { "kr": "싫으면 다른 것으로 바꾸세요.", "cn": "如果你不喜欢，就换别的吧。" },
        { "kr": "스트레스가 쌓이면 어떻게 하세요?", "cn": "如果积累了很多压力，你会怎么做呢？" }
      ]
    },
    {
      "id": "g8_6",
      "pattern": "V/A-을/ㄹ 거예요",
      "meaning": "将要……，打算……；可能会……，大概……（表示未来计划或推测）",
      "usage": "用于谓词词干和体词谓词形（N이다）后面。词干以辅音（有收音）结尾时用“-을 거예요”，以元音（无收音）或收音“ㄹ”结尾时用“-ㄹ 거예요”。用法分为两种：（1）如果主语是第一人称或第二人称，表示说话人的意志或打算（疑问句询问对方的打算）；（2）如果主语是第三人称（或与形容词、体词结合），表示说话人的推测或猜想。",
      "examples": [
        { "kr": "이번 주말에는 집에서 푹 쉴 거예요.", "cn": "这个周末我要在家好好休息。" },
        { "kr": "내일 몇 시에 오실 거예요?", "cn": "你明天几点钟来？" },
        { "kr": "저녁에 불고기를 만들 거예요.", "cn": "晚上我要做烤肉。" },
        { "kr": "이번 겨울은 좀 추울 거예요.", "cn": "这个冬天会有点冷。" },
        { "kr": "영수 씨가 요즘 좀 바쁠 거예요.", "cn": "英秀这几天会有点忙。" },
        { "kr": "기차가 곧 도착할 거예요.", "cn": "火车马上就会到达的。" }
      ]
    },
    {
      "id": "g8_7",
      "pattern": "N만",
      "meaning": "只，仅仅，光（表示限定）",
      "usage": "用于名词、代词或部分副词（如“잠깐、조금”等）后面的补助词，表示排除其他事物，仅限于某一方面，相当于汉语的“仅仅、只”。当与主格助词“이/가”或宾格助词“을/를”结合时，“이/가、을/를”通常省略。",
      "examples": [
        { "kr": "10분만 자고 싶어요.", "cn": "我只想睡十分钟。" },

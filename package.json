{
  "name": "kr_learn",
  "version": "1.0.0",
  "description": "Self-learning Korean Language.",
  "main": "app.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./www/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./www/styles.css --watch",
    "sync:vendor": "mkdir -p www/vendor && cp node_modules/@supabase/supabase-js/dist/umd/supabase.js www/vendor/supabase.js",
    "build": "npm run sync:vendor && npm run build:css",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hannirio/kr_learn.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/hannirio/kr_learn/issues"
  },
  "homepage": "https://github.com/hannirio/kr_learn#readme",
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@supabase/supabase-js": "^2.119.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "tailwindcss": "^3.4.19"
  }
}
